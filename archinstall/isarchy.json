{
  "archinstall-language": "English",
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": false
  },
  "custom_commands": [
    "/run/isarchy/install/target-install.sh"
  ],
  "hostname": "isarchy",
  "kernels": [
    "linux"
  ],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": [
    "sudo"
  ],
  "pacman_config": {
    "color": true,
    "parallel_downloads": 5
  },
  "script": "guided",
  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },
  "timezone": "UTC"
}
